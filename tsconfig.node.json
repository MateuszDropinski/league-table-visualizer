{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    // Node strips types and runs these scripts directly, so their imports carry
    // real .ts extensions rather than being rewritten by a bundler.
    "allowImportingTsExtensions": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    "noEmit": true
  },
  "include": ["vite.config.ts", "scripts", "tests"]
}
